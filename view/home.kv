#:import dp kivy.metrics.dp

<AreaNavegador>:
    orientation: 'vertical'
    spacing: dp(8)
    padding: dp(14)
    size_hint_y: .52
    style: 'elevated'
    elevation: 3
    radius: [dp(22), dp(22), dp(22), dp(22)]
    md_bg_color: .06, .21, .48, .98

    Label:
        text: 'Aplicativos e serviços'
        color: 1, 1, 1, 1
        bold: True
        font_size: '16sp'
        size_hint_y: None
        height: dp(24)

    ScrollView:
        do_scroll_x: True
        do_scroll_y: False
        bar_width: dp(7)
        bar_color: .38, .72, 1, .85
        bar_inactive_color: .38, .72, 1, .22

        GridLayout:
            id: shortcuts_grid
            rows: 2
            orientation: 'lr-tb'
            size_hint: None, 1
            col_force_default: True
            col_default_width: max(dp(168), min(dp(320), (root.width - dp(96)) / 6))
            width: max(root.width - dp(32), self.minimum_width)
            spacing: dp(10), dp(8)


<AtalhoNavegador>:
    orientation: 'vertical'
    padding: dp(10), dp(8)
    spacing: dp(4)
    style: 'filled'
    md_bg_color: app.theme_surface
    radius: [dp(18), dp(18), dp(18), dp(18)]
    elevation: 2
    ripple_behavior: True
    focus_behavior: True

    AnchorLayout:
        anchor_x: 'center'
        anchor_y: 'center'

        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height
            spacing: dp(4)

            AnchorLayout:
                size_hint_y: None
                height: dp(44)
                Image:
                    source: root.icone
                    opacity: 1 if root.icone else 0
                    size_hint: None, None
                    size: dp(38), dp(38)
                    allow_stretch: True
                    keep_ratio: True

                IconeUI:
                    nome: root.simbolo if root.simbolo else 'apps'
                    opacity: 1 if root.simbolo and not root.icone else 0
                    size_hint: None, None
                    size: dp(38), dp(38)
                    font_size: '32sp'
                    color: app.theme_text

            Label:
                text: root.titulo
                color: app.theme_text
                bold: True
                font_size: '13sp'
                size_hint_y: None
                height: dp(24)
                halign: 'center'
                valign: 'middle'
                text_size: self.size


<TelaPrincipal>:
    orientation: 'vertical'
    spacing: 0

    Cabecalho:
        id: cabecalho

    BoxLayout:
        orientation: 'vertical'
        padding: dp(24), dp(14)
        spacing: dp(12)

        CartaoMaterial:
            size_hint_y: .48
            md_bg_color: app.theme_surface
            padding: dp(8)

            ScrollView:
                id: menu_scroll
                do_scroll_x: False
                do_scroll_y: True
                bar_width: dp(5)
                bar_color: 0.25, 0.50, 0.85, 0.65
                bar_inactive_color: 0.25, 0.50, 0.85, 0.14

                GridLayout:
                    id: menu_grid
                    cols: 2 if menu_scroll.width >= dp(960) else 1
                    size_hint_y: None
                    height: self.minimum_height
                    padding: dp(8)
                    spacing: dp(12)

                    CardMenu:
                        titulo: "Extensões"
                        descricao: "Acesse o catálogo, instale módulos aprovados e execute as extensões instaladas."
                        icone: 'puzzle-outline'
                        size_hint_y: None
                        height: dp(186)
                        on_release: root.abrir_extensoes()

                    CardMenu:
                        titulo: "Conteúdo Teórico e Didático"
                        descricao: "Acesse materiais de estudo, tutoriais e recursos educacionais para aprimorar suas habilidades."
                        icone: 'book-open-page-variant-outline'
                        size_hint_y: None
                        height: dp(186)
                        on_release: root.abrir_materias()

                    CardMenu:
                        titulo: "Conteúdo Prático e Aplicações"
                        descricao: "Abra matérias práticas fixas do sistema e simule circuitos interativos."
                        icone: 'flask-outline'
                        size_hint_y: None
                        height: dp(186)
                        on_release: root.abrir_praticas()

                    CardMenu:
                        titulo: "Configurações"
                        descricao: "Personalize sua conta, os serviços rápidos e o comportamento do PM-Painel."
                        icone: 'cog-outline'
                        size_hint_y: None
                        height: dp(186)
                        on_release: root.abrir_configuracoes()

                    CardMenu:
                        titulo: "Painel de controle"
                        descricao: "Gerencie contas de equipe e matérias sob responsabilidade de cada professor."
                        icone: 'account-group-outline'
                        opacity: 1 if root.is_moderator else 0
                        disabled: not root.is_moderator
                        size_hint_y: None
                        height: dp(186) if root.is_moderator else 0
                        on_release: root.abrir_usuarios()

        AreaNavegador:
            id: browser_area

    Rodape:
        size_hint_y: None
        height: 30
