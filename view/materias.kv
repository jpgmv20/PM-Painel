#:import dp kivy.metrics.dp

<TelaMaterias>:
    orientation: 'vertical'
    spacing: 0

    Cabecalho:
        titulo: root.titulo

    BoxLayout:
        orientation: 'vertical'
        padding: dp(28), dp(16)
        spacing: dp(12)

        canvas.before:
            Color:
                rgba: 0, 0, 0, .18
            RoundedRectangle:
                pos: self.x + dp(4), self.y - dp(4)
                size: self.size
                radius: [dp(22)]
            Color:
                rgba: app.theme_surface
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(22)]

        BoxLayout:
            size_hint_y: None
            height: dp(54)
            spacing: dp(12)

            BotaoAcao:
                text: 'Painel'
                variant: 'secondary'
                size_hint_x: None
                width: dp(124)
                height: dp(44)
                color: 1, 1, 1, 1
                on_release: root.voltar()

            BoxLayout:
                orientation: 'vertical'
                Label:
                    text: 'Espaço de aprendizagem'
                    color: app.theme_text
                    bold: True
                    font_size: '17sp'
                    halign: 'left'
                    valign: 'bottom'
                    text_size: self.size
                Label:
                    text: root.status_texto
                    color: app.theme_muted
                    font_size: '11sp'
                    halign: 'left'
                    valign: 'top'
                    text_size: self.size

            CampoTexto:
                id: busca_equipes
                text: root.filtro_equipes
                hint_text: 'Buscar turma ou matéria'
                multiline: False
                size_hint_x: None
                width: dp(250) if not root.equipe_id else 0
                opacity: 1 if not root.equipe_id else 0
                disabled: bool(root.equipe_id)
                surface_color: app.theme_surface
                text_color: app.theme_text
                hint_color: app.theme_muted
                cursor_color: .12, .42, .82, 1
                on_text: root.filtrar_equipes(self.text)

            BotaoAcao:
                text: 'Criar turma'
                variant: 'primary'
                size_hint_x: None
                width: dp(156) if root.pode_gerenciar_materia and not root.equipe_id else 0
                height: dp(44)
                opacity: 1 if root.pode_gerenciar_materia and not root.equipe_id else 0
                disabled: not root.pode_gerenciar_materia or bool(root.equipe_id)
                color: 1, 1, 1, 1
                on_release: root.editar_materia()

        BoxLayout:
            orientation: 'vertical'
            padding: dp(14)
            canvas.before:
                Color:
                    rgba: app.theme_surface
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(16)]

            ScrollView:
                id: conteudo_scroll
                do_scroll_x: False
                do_scroll_y: True
                scroll_type: ['bars', 'content']
                bar_width: dp(7)
                bar_color: .18, .48, .86, .82
                bar_inactive_color: .18, .48, .86, .2

                GridLayout:
                    id: conteudo
                    cols: 3
                    spacing: dp(14)
                    padding: dp(4)
                    size_hint_y: None
                    height: self.minimum_height

    Rodape:
        size_hint_y: None
        height: dp(34)
