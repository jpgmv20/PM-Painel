<TelaLogin>:
    orientation: 'vertical'
    spacing: 0

    Cabecalho:
        id: cabecalho

    BoxLayout:
        orientation: 'vertical'
        padding: dp(24)

        AnchorLayout:
            anchor_x: 'center'
            anchor_y: 'center'

            BoxLayout:
                orientation: 'vertical'
                size_hint: None, None
                width: min(root.width - dp(48), dp(420))
                height: self.minimum_height
                padding: dp(32), dp(28)
                spacing: dp(14)

                canvas.before:
                    Color:
                        rgba: 0.03, 0.10, 0.22, 0.16
                    RoundedRectangle:
                        pos: self.x + dp(4), self.y - dp(6)
                        size: self.size
                        radius: [dp(20)]
                    Color:
                        rgba: 1, 1, 1, 0.97
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(20)]

                Image:
                    source: 'assets/icon/google.png'
                    size_hint: None, None
                    size: dp(64), dp(64)
                    pos_hint: {'center_x': .5}
                    fit_mode: 'contain'

                Label:
                    text: 'Bem-vindo!'
                    color: 0.06, 0.10, 0.18, 1
                    bold: True
                    font_size: '28sp'
                    halign: 'center'
                    text_size: self.width, None
                    size_hint_y: None
                    height: self.texture_size[1]

                Label:
                    text: 'Entre com sua conta Google para acessar o painel de controle.'
                    color: 0.35, 0.39, 0.46, 1
                    font_size: '15sp'
                    halign: 'center'
                    valign: 'middle'
                    text_size: self.width, None
                    size_hint_y: None
                    height: self.texture_size[1]

                Button:
                    text: ''
                    background_color: 0, 0, 0, 0
                    background_normal: ''
                    disabled: root.login_em_andamento
                    size_hint_y: None
                    height: dp(52)
                    on_release: root.login_google()

                    canvas.before:
                        Color:
                            rgba: (.20, .20, .20, .65) if self.disabled else (.14, .18, .24, 1)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(14)]

                    AnchorLayout:
                        size: self.parent.size
                        pos: self.parent.pos
                        anchor_x: 'center'
                        anchor_y: 'center'

                        BoxLayout:
                            size_hint: None, None
                            size: self.minimum_size
                            spacing: dp(10)

                            Image:
                                source: 'assets/icon/google.png'
                                size_hint: None, None
                                size: dp(22), dp(22)
                                fit_mode: 'contain'

                            Label:
                                text: 'Conectando...' if root.login_em_andamento else 'Entrar com Google'
                                size_hint: None, None
                                size: self.texture_size
                                color: 1, 1, 1, 1
                                bold: True

                Label:
                    text: root.status_texto
                    color: root.status_cor
                    font_size: '13sp'
                    halign: 'center'
                    text_size: self.width, None
                    size_hint_y: None
                    height: self.texture_size[1] if self.text else 0

                Label:
                    text: 'Ao continuar, você concorda com nossos Termos de Uso.'
                    color: 0.47, 0.50, 0.56, 1
                    font_size: '12sp'
                    halign: 'center'
                    text_size: self.width, None
                    size_hint_y: None
                    height: self.texture_size[1]

    Rodape:
        size_hint_y: None
        height: dp(40)
