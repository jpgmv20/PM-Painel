<TelaLogin>:
    orientation: 'vertical'
    spacing: 0

    Cabecalho:
        id: cabecalho
        gradiente_login: True

    BoxLayout:
        orientation: 'horizontal'
        padding: dp(24), dp(18)
        spacing: dp(24)

        BoxLayout:
            orientation: 'vertical'
            size_hint_x: .38 if root.width >= dp(940) else 0
            opacity: 1 if root.width >= dp(940) else 0
            padding: dp(40), dp(32)
            spacing: dp(18)
            canvas.before:
                Color:
                    rgba: .035, .13, .30, .96
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(64), dp(18), dp(64), dp(18)]
                Color:
                    rgba: .18, .58, .94, .24
                Ellipse:
                    pos: self.right - dp(170), self.top - dp(170)
                    size: dp(240), dp(240)
                Color:
                    rgba: .34, .77, 1, .28
                Line:
                    points: [self.x + dp(38), self.y + dp(55), self.x + dp(155), self.y + dp(55), self.x + dp(206), self.y + dp(106)]
                    width: dp(1.2)

            Widget:
                size_hint_y: .7

            IconeUI:
                nome: 'account-group'
                size_hint: None, None
                font_size: '66sp'
                color: .48, .80, 1, 1

            Label:
                text: 'PM - Painel'
                color: 1, 1, 1, 1
                bold: True
                font_size: '34sp'
                size_hint_y: None
                height: dp(46)
                halign: 'left'
                text_size: self.size

            Label:
                text: 'A sala da sua equipe, sempre à mão.'
                color: .80, .89, 1, 1
                font_size: '18sp'
                halign: 'left'
                valign: 'top'
                text_size: self.width, None
                size_hint_y: None
                height: dp(70)

            Widget:
                size_hint_y: .9

        AnchorLayout:
            anchor_x: 'center'
            anchor_y: 'center'
            size_hint_x: .62 if root.width >= dp(940) else 1

            BoxLayout:
                orientation: 'vertical'
                size_hint: None, None
                width: min(dp(500), root.width * .48) if root.width >= dp(940) else min(dp(500), root.width - dp(72))
                height: self.minimum_height
                padding: dp(34), dp(30)
                spacing: dp(14)

                canvas.before:
                    Color:
                        rgba: 0.03, 0.10, 0.22, 0.16
                    RoundedRectangle:
                        pos: self.x + dp(8), self.y - dp(9)
                        size: self.size
                        radius: [dp(32)]
                    Color:
                        rgba: 1, 1, 1, 0.97
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(32)]

                Image:
                    source: 'assets/icon/google.png'
                    size_hint: None, None
                    size: dp(64), dp(64)
                    pos_hint: {'center_x': .5}
                    fit_mode: 'contain'

                Label:
                    text: 'Bem-vindo de volta'
                    color: 0.06, 0.10, 0.18, 1
                    bold: True
                    font_size: '28sp'
                    halign: 'center'
                    text_size: self.width, None
                    size_hint_y: None
                    height: self.texture_size[1]

                Label:
                    text: 'Acesse suas aulas, arquivos e conversas de equipe.'
                    color: 0.35, 0.39, 0.46, 1
                    font_size: '15sp'
                    halign: 'center'
                    valign: 'middle'
                    text_size: self.width, None
                    size_hint_y: None
                    height: self.texture_size[1]

                CampoTextoClassico:
                    id: email_input
                    hint_text: 'E-mail'
                    multiline: False
                    size_hint_y: None
                    height: dp(48)

                CampoTextoClassico:
                    id: password_input
                    hint_text: 'Senha'
                    password: True
                    multiline: False
                    size_hint_y: None
                    height: dp(48)

                BotaoAcao:
                    variant: 'primary'
                    text: 'Entrar com e-mail e senha'
                    icone: ''
                    size_hint_y: None
                    height: dp(50)
                    color: 1, 1, 1, 1
                    on_release: root.login_com_senha()

                BotaoAcao:
                    variant: 'light'
                    text: 'Criar conta de aluno'
                    icone: ''
                    size_hint_y: None
                    height: dp(46)
                    color: .05, .20, .48, 1
                    on_release: root.abrir_cadastro()

                Label:
                    text: 'ou entre com sua conta institucional'
                    color: 0.47, 0.50, 0.56, 1
                    font_size: '12sp'
                    halign: 'center'
                    size_hint_y: None
                    height: dp(20)

                BotaoAcao:
                    variant: 'secondary'
                    text: ''
                    disabled: root.login_em_andamento
                    size_hint_y: None
                    height: dp(50)
                    on_release: root.login_google()

                    AnchorLayout:
                        size: self.parent.size
                        pos: self.parent.pos
                        anchor_x: 'center'
                        anchor_y: 'center'

                        BoxLayout:
                            size_hint: None, None
                            size: self.minimum_size
                            spacing: dp(10)

                            Image:
                                source: 'assets/icon/google.png'
                                size_hint: None, None
                                size: dp(22), dp(22)
                                fit_mode: 'contain'

                            Label:
                                text: 'Conectando...' if root.login_em_andamento else 'Entrar com Google'
                                size_hint: None, None
                                size: self.texture_size
                                color: 1, 1, 1, 1
                                bold: True

                Label:
                    text: root.status_texto
                    color: root.status_cor
                    font_size: '13sp'
                    halign: 'center'
                    text_size: self.width, None
                    size_hint_y: None
                    height: self.texture_size[1] if self.text else 0

                Label:
                    text: 'Ao continuar, você concorda com nossos Termos de Uso.'
                    color: 0.47, 0.50, 0.56, 1
                    font_size: '12sp'
                    halign: 'center'
                    text_size: self.width, None
                    size_hint_y: None
                    height: self.texture_size[1]

    Rodape:
        size_hint_y: None
        height: dp(40)
