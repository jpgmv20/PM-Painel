<TelaDockerErro>:
    orientation: 'vertical'
    spacing: 0

    Cabecalho:
        id: cabecalho
        titulo: "PM - Painel • Diagnóstico do Docker"

    AnchorLayout:
        anchor_x: 'center'
        anchor_y: 'center'
        padding: dp(24)

        BoxLayout:
            orientation: 'vertical'
            size_hint: None, None
            width: min(dp(560), root.width - dp(40))
            height: self.minimum_height
            padding: dp(32), dp(26)
            spacing: dp(14)

            canvas.before:
                Color:
                    rgba: 0.02, 0.08, 0.18, 0.22
                RoundedRectangle:
                    pos: self.x + dp(4), self.y - dp(6)
                    size: self.size
                    radius: [dp(24)]
                Color:
                    rgba: app.theme_surface
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(24)]
                Color:
                    rgba: (root.status_cor[0], root.status_cor[1], root.status_cor[2], 0.35)
                Line:
                    rounded_rectangle: (self.x, self.y, self.width, self.height, dp(24))
                    width: dp(1.2)

            AnchorLayout:
                size_hint_y: None
                height: dp(68)
                anchor_x: 'center'
                anchor_y: 'center'

                Widget:
                    size_hint: None, None
                    size: dp(64), dp(64)
                    canvas.before:
                        Color:
                            rgba: (root.status_cor[0], root.status_cor[1], root.status_cor[2], 0.16)
                        Ellipse:
                            pos: self.pos
                            size: self.size
                    IconeUI:
                        nome: 'docker' if not root.iniciando_docker else 'sync'
                        size_hint: None, None
                        size: dp(40), dp(40)
                        font_size: '40sp'
                        color: root.status_cor
                        pos: self.parent.x + dp(12), self.parent.y + dp(12)

            Label:
                text: root.titulo_erro
                font_size: '22sp'
                bold: True
                color: app.theme_text
                halign: 'center'
                valign: 'middle'
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1]

            Label:
                text: root.descricao_erro
                font_size: '13sp'
                color: app.theme_muted
                halign: 'center'
                valign: 'middle'
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1] + dp(4)

            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: dp(14), dp(10)
                spacing: dp(4)
                canvas.before:
                    Color:
                        rgba: (.08, .18, .32, 0.08) if app.settings.theme == 'Claro' else (.05, .10, .18, 0.5)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(12)]
                    Color:
                        rgba: (root.status_cor[0], root.status_cor[1], root.status_cor[2], 0.3)
                    Line:
                        rounded_rectangle: (self.x, self.y, self.width, self.height, dp(12))
                        width: dp(0.8)

                BoxLayout:
                    size_hint_y: None
                    height: dp(24)
                    spacing: dp(8)

                    IconeUI:
                        nome: 'check-circle' if root.docker_pronto else ('sync' if root.iniciando_docker else 'alert-circle-outline')
                        size_hint: None, None
                        size: dp(18), dp(18)
                        font_size: '17sp'
                        color: root.status_cor
                        pos_hint: {'center_y': 0.5}

                    Label:
                        text: root.status_texto
                        font_size: '13sp'
                        bold: True
                        color: root.status_cor
                        halign: 'left'
                        valign: 'middle'
                        text_size: self.size

                Label:
                    text: root.progresso_texto
                    font_size: '11sp'
                    color: app.theme_muted
                    halign: 'left'
                    valign: 'top'
                    text_size: self.width, None
                    size_hint_y: None
                    height: max(dp(22), self.texture_size[1])

            Widget:
                size_hint_y: None
                height: dp(6)

            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(10)

                BotaoAcao:
                    text: "Entrar no PM-Painel" if root.docker_pronto else ("Iniciando Docker... Aguarde" if root.iniciando_docker else "Ativar Docker e iniciar programa")
                    icone: 'arrow-right' if root.docker_pronto else ('sync' if root.iniciando_docker else 'power')
                    variant: 'primary'
                    size_hint_y: None
                    height: dp(48)
                    disabled: root.iniciando_docker
                    on_release: root.iniciar_programa() if root.docker_pronto else root.iniciar_servico_docker()

                BoxLayout:
                    size_hint_y: None
                    height: dp(42)
                    spacing: dp(10)

                    BotaoAcao:
                        text: "Verificar novamente"
                        icone: 'refresh'
                        variant: 'light'
                        size_hint_x: 0.5
                        height: dp(42)
                        disabled: root.iniciando_docker
                        on_release: root.verificar_novamente()

                    BotaoAcao:
                        text: "Continuar sem Docker"
                        icone: 'arrow-right'
                        variant: 'secondary'
                        size_hint_x: 0.5
                        height: dp(42)
                        disabled: root.iniciando_docker
                        on_release: root.continuar_sem_docker()

                BotaoAcao:
                    text: "Sair do aplicativo"
                    icone: 'exit-to-app'
                    variant: 'quiet'
                    size_hint_y: None
                    height: dp(36)
                    disabled: root.iniciando_docker
                    on_release: app.solicitar_saida()

    Rodape:
