#:import dp kivy.metrics.dp

<ListaSeletorConfiguracao>:
    do_scroll_x: False
    bar_color: .32, .58, .92, .85
    bar_inactive_color: .32, .58, .92, .20
    canvas.before:
        Color:
            rgba: app.theme_surface
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]

<OpcaoSeletorConfiguracao>:
    size_hint_y: None
    height: dp(42)
    background_normal: ''
    background_down: ''
    background_color: 0, 0, 0, 0
    color: app.theme_text
    font_name: app.font_family_medium
    font_size: '14sp'
    halign: 'left'
    valign: 'middle'
    padding: dp(14), 0
    canvas.before:
        Color:
            rgba: (.13, .32, .55, .38) if self.state == 'down' else (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.x + dp(3), self.y + dp(2)
            size: self.width - dp(6), self.height - dp(4)
            radius: [dp(10)]

<SeletorConfiguracao>:
    option_cls: 'OpcaoSeletorConfiguracao'
    dropdown_cls: 'ListaSeletorConfiguracao'
    background_normal: ''
    background_down: ''
    background_color: 0, 0, 0, 0
    color: app.theme_text
    font_name: app.font_family_medium
    font_size: '14sp'
    halign: 'left'
    valign: 'middle'
    padding: dp(14), 0
    text_size: self.width - dp(42), self.height
    shorten: True
    canvas.before:
        Color:
            rgba: app.theme_surface
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]
        Color:
            rgba: (.24, .52, .86, 1) if root.is_open else (.42, .52, .66, .48)
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(12))
            width: dp(1.2) if root.is_open else dp(.9)
    IconeUI:
        nome: 'chevron-up' if root.is_open else 'chevron-down'
        size_hint: None, None
        size: dp(18), dp(18)
        font_size: '18sp'
        color: app.theme_muted
        pos: root.right - dp(30), root.center_y - dp(9)

<ConfiguracaoOpcao>:
    size_hint_y: None
    height: dp(74) if not root.aviso else dp(90)
    padding: dp(16), dp(10)
    spacing: dp(12)
    canvas.before:
        StencilPush
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]
        StencilUse
        Color:
            rgba: app.theme_surface
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(10)]
        Color:
            rgba: (.12, .48, .87, 1) if root.active else (.36, .51, .72, .46)
        RoundedRectangle:
            pos: self.x + dp(4), self.y + dp(12)
            size: dp(4), max(dp(8), self.height - dp(24))
            radius: [dp(2)]
    canvas.after:
        StencilUnUse
        StencilPop
    BoxLayout:
        orientation: 'vertical'
        Label:
            text: root.titulo
            color: app.theme_text
            bold: True
            font_size: '15sp'
            halign: 'left'
            text_size: self.width, None
        Label:
            text: root.descricao
            color: app.theme_muted
            font_size: '12sp'
            halign: 'left'
            text_size: self.width, None
        Label:
            text: root.aviso
            color: .76, .42, .06, 1
            font_size: '11sp'
            halign: 'left'
            text_size: self.width, None
            size_hint_y: None
            height: self.texture_size[1] if self.text else 0
    Switch:
        size_hint: None, None
        size: dp(54), dp(32)
        active: root.active
        disabled: root.admin_only and not app.is_moderator
        on_active: root.active = self.active

<ServicoOpcao>:
    size_hint_y: None
    height: dp(82)
    padding: dp(14), dp(10)
    spacing: dp(10)
    canvas.before:
        StencilPush
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(10)]
        StencilUse
        Color:
            rgba: app.theme_surface
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(10)]
    canvas.after:
        StencilUnUse
        StencilPop
    AnchorLayout:
        size_hint_x: None
        width: dp(30)
        Image:
            source: root.imagem
            opacity: 1 if root.imagem else 0
            size_hint: None, None
            size: dp(28), dp(28)
            allow_stretch: True
            keep_ratio: True
        IconeUI:
            nome: root.simbolo if root.simbolo else 'apps'
            opacity: 1 if root.simbolo and not root.imagem else 0
            size_hint: None, None
            size: dp(26), dp(26)
            font_size: '22sp'
            color: app.theme_text
    BoxLayout:
        orientation: 'vertical'
        Label:
            text: root.titulo
            color: app.theme_text
            bold: True
            font_size: '14sp'
            halign: 'left'
            text_size: self.width, None
        Label:
            text: root.descricao
            color: app.theme_muted
            font_size: '11sp'
            halign: 'left'
            text_size: self.width, None
    Switch:
        size_hint: None, None
        size: dp(48), dp(30)
        active: root.active
        on_active: root.active = self.active

<TelaConfiguracoes>:
    orientation: 'vertical'
    Cabecalho:
        titulo: 'Configurações'
    BoxLayout:
        orientation: 'vertical'
        padding: dp(36), dp(16)
        spacing: dp(12)
        BoxLayout:
            size_hint_y: None
            height: dp(54)
            BotaoAcao:
                text: '<'
                variant: 'light'
                size_hint: None, None
                size: dp(52), dp(46)
                on_release: root.voltar_para_painel(self)

                IconeUI:
                    nome: 'arrow-left'
                    font_size: '21sp'
                    color: .05, .20, .48, 1
                    pos_hint: {'center_x': .5, 'center_y': .5}
            BoxLayout:
                orientation: 'vertical'
                padding: dp(12), 0
                Label:
                    text: 'Personalize o comportamento do PM-Painel'
                    color: app.theme_text
                    bold: True
                    font_size: '22sp'
                    halign: 'left'
                    text_size: self.width, None
                Label:
                    text: 'As alterações são salvas automaticamente neste computador.'
                    color: app.theme_muted
                    font_size: '12sp'
                    halign: 'left'
                    text_size: self.width, None
        Label:
            text: app.settings_feedback
            color: (0.72, 0.86, 1, 1) if app.settings.theme == 'Escuro' else (0.18, 0.36, 0.62, 1)
            font_size: '12sp'
            size_hint_y: None
            height: dp(22) if self.text else 0
            halign: 'left'
            text_size: self.width, None
        ScrollView:
            do_scroll_x: False
            bar_width: dp(8)
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(18)
                padding: dp(2), dp(2), dp(12), dp(26)
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(8)
                    Label:
                        text: 'Geral'
                        color: .05, .20, .48, 1
                        bold: True
                        font_size: '20sp'
                        size_hint_y: None
                        height: dp(28)
                        halign: 'left'
                        text_size: self.width, None
                    ConfiguracaoOpcao:
                        titulo: 'Iniciar PM-Painel com o Windows'
                        descricao: 'Adiciona ou remove o PM-Painel da inicialização do seu usuário do Windows.'
                        key: 'start_with_windows'
                        active: app.settings.start_with_windows
                    ConfiguracaoOpcao:
                        titulo: 'Abrir tela de login ao iniciar o painel'
                        descricao: 'Abre a autenticação sem passar pela tela de boas-vindas.'
                        key: 'start_after_login'
                        active: app.settings.start_after_login
                    ConfiguracaoOpcao:
                        titulo: 'Minimizar para a bandeja'
                        descricao: 'O botão fechar oculta o painel; use o ícone da bandeja para restaurá-lo ou sair.'
                        key: 'minimize_to_tray'
                        active: app.settings.minimize_to_tray
                    ConfiguracaoOpcao:
                        titulo: 'Confirmar antes de fechar'
                        descricao: 'Mostra uma confirmação antes de encerrar o aplicativo.'
                        key: 'confirm_before_close'
                        active: app.settings.confirm_before_close
                    ConfiguracaoOpcao:
                        titulo: 'Verificar Docker ao iniciar'
                        descricao: 'Exibe tela de aviso e ativação se o Docker estiver fechado.'
                        key: 'check_docker_on_startup'
                        active: app.settings.check_docker_on_startup
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(8)
                    Label:
                        text: 'Conta e funcionamento offline'
                        color: .05, .20, .48, 1
                        bold: True
                        font_size: '20sp'
                        size_hint_y: None
                        height: dp(28)
                        halign: 'left'
                        text_size: self.width, None
                    ConfiguracaoOpcao:
                        titulo: 'Modo offline'
                        descricao: 'Desativa ações que precisam de internet; matérias e preferências locais continuam acessíveis.'
                        key: 'offline_mode'
                        active: app.settings.offline_mode
                    BoxLayout:
                        size_hint_y: None
                        height: dp(64)
                        padding: dp(16), dp(10)
                        spacing: dp(10)
                        canvas.before:
                            Color:
                                rgba: app.theme_surface
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(14)]
                        IconeUI:
                            nome: 'theme-light-dark'
                            size_hint: None, None
                            size: dp(22), dp(22)
                            font_size: '21sp'
                            color: app.theme_muted
                        Label:
                            text: 'Tema da interface'
                            color: app.theme_text
                            bold: True
                            font_size: '15sp'
                            halign: 'left'
                            text_size: self.width, None
                        SeletorConfiguracao:
                            text: app.settings.theme
                            values: ('Dark', 'Light') if app.settings.language.startswith('English') else ('Escuro', 'Claro')
                            size_hint_x: None
                            width: dp(160)
                            on_text: root.set_choice('theme', self.text)
                    BoxLayout:
                        size_hint_y: None
                        height: dp(64)
                        padding: dp(16), dp(10)
                        spacing: dp(10)
                        canvas.before:
                            Color:
                                rgba: app.theme_surface
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(14)]
                        IconeUI:
                            nome: 'translate'
                            size_hint: None, None
                            size: dp(22), dp(22)
                            font_size: '21sp'
                            color: app.theme_muted
                        Label:
                            text: 'Idioma preferido'
                            color: app.theme_text
                            bold: True
                            font_size: '15sp'
                            halign: 'left'
                            text_size: self.width, None
                        SeletorConfiguracao:
                            text: app.settings.language
                            values: ('Português (Brasil)', 'English')
                            size_hint_x: None
                            width: dp(190)
                            on_text: root.set_choice('language', self.text)
                    Label:
                        text: 'O conteúdo dos materiais cadastrados não é traduzido automaticamente.'
                        color: app.theme_muted
                        font_size: '12sp'
                        size_hint_y: None
                        height: dp(20)
                        halign: 'left'
                        text_size: self.width, None
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(8)
                    Label:
                        text: 'Aplicativos e serviços'
                        color: .05, .20, .48, 1
                        bold: True
                        font_size: '20sp'
                        size_hint_y: None
                        height: dp(28)
                        halign: 'left'
                        text_size: self.width, None
                    Label:
                        text: 'Escolha os serviços que aparecerão nos acessos rápidos da Home.'
                        color: app.theme_muted
                        font_size: '13sp'
                        size_hint_y: None
                        height: dp(20)
                        halign: 'left'
                        text_size: self.width, None
                    GridLayout:
                        cols: 4 if self.width >= dp(1280) else 3 if self.width >= dp(900) else 2
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(10)
                        ServicoOpcao:
                            titulo: 'Google'
                            descricao: 'Navegador temporário'
                            imagem: 'assets/icon/google.png'
                            simbolo: 'google-chrome'
                            key: 'show_google'
                            active: app.settings.show_google
                        ServicoOpcao:
                            titulo: 'YouTube'
                            descricao: 'Vídeos e conteúdos'
                            imagem: 'assets/icon/youtube.png'
                            simbolo: 'youtube'
                            key: 'show_youtube'
                            active: app.settings.show_youtube
                        ServicoOpcao:
                            titulo: 'Outlook'
                            descricao: 'E-mail institucional web'
                            imagem: 'assets/icon/outlook.png'
                            simbolo: 'microsoft-outlook'
                            key: 'show_outlook'
                            active: app.settings.show_outlook
                        ServicoOpcao:
                            titulo: 'Teams web'
                            descricao: 'Comunicação Microsoft'
                            imagem: 'assets/icon/teams.png'
                            simbolo: 'microsoft-teams'
                            key: 'show_teams'
                            active: app.settings.show_teams
                        ServicoOpcao:
                            titulo: 'Word web'
                            descricao: 'Documentos Microsoft'
                            imagem: 'assets/icon/word.png'
                            simbolo: 'microsoft-word'
                            key: 'show_word'
                            active: app.settings.show_word
                        ServicoOpcao:
                            titulo: 'Excel web'
                            descricao: 'Planilhas Microsoft'
                            imagem: 'assets/icon/excel.png'
                            simbolo: 'microsoft-excel'
                            key: 'show_excel'
                            active: app.settings.show_excel
                        ServicoOpcao:
                            titulo: 'OneDrive web'
                            descricao: 'Arquivos Microsoft'
                            imagem: 'assets/icon/onedrive.png'
                            simbolo: 'microsoft-onedrive'
                            key: 'show_onedrive'
                            active: app.settings.show_onedrive
                        ServicoOpcao:
                            titulo: 'Google Drive web'
                            descricao: 'Arquivos Google'
                            imagem: 'assets/icon/google_drive.png'
                            simbolo: 'google-drive'
                            key: 'show_google_drive'
                            active: app.settings.show_google_drive
                        ServicoOpcao:
                            titulo: 'Google Agenda'
                            descricao: 'Calendário e compromissos'
                            imagem: 'assets/icon/google_calendar.png'
                            simbolo: 'calendar-month-outline'
                            key: 'show_google_calendar'
                            active: app.settings.show_google_calendar
                        ServicoOpcao:
                            titulo: 'Google Meet'
                            descricao: 'Reuniões e chamadas'
                            imagem: 'assets/icon/google_meet.png'
                            simbolo: 'video-outline'
                            key: 'show_google_meet'
                            active: app.settings.show_google_meet
                        ServicoOpcao:
                            titulo: 'Google Docs'
                            descricao: 'Documentos colaborativos'
                            imagem: 'assets/icon/google_docs.png'
                            simbolo: 'file-document-outline'
                            key: 'show_google_docs'
                            active: app.settings.show_google_docs
                        ServicoOpcao:
                            titulo: 'Google Slides'
                            descricao: 'Apresentações'
                            imagem: 'assets/icon/google_slides.png'
                            simbolo: 'presentation'
                            key: 'show_google_slides'
                            active: app.settings.show_google_slides
                        ServicoOpcao:
                            titulo: 'Google Forms'
                            descricao: 'Formulários e pesquisas'
                            imagem: 'assets/icon/google_forms.png'
                            simbolo: 'clipboard-list-outline'
                            key: 'show_google_forms'
                            active: app.settings.show_google_forms
                        ServicoOpcao:
                            titulo: 'Google Maps'
                            descricao: 'Mapas e localização'
                            imagem: 'assets/icon/google_maps.png'
                            simbolo: 'map-marker-outline'
                            key: 'show_google_maps'
                            active: app.settings.show_google_maps
                        ServicoOpcao:
                            titulo: 'Google Keep'
                            descricao: 'Notas rápidas'
                            imagem: 'assets/icon/google_keep.png'
                            simbolo: 'note-text-outline'
                            key: 'show_google_keep'
                            active: app.settings.show_google_keep
                        ServicoOpcao:
                            titulo: 'Canva'
                            descricao: 'Designs e apresentações'
                            imagem: 'assets/icon/canva.png'
                            simbolo: 'palette-outline'
                            key: 'show_canva'
                            active: app.settings.show_canva
                        ServicoOpcao:
                            titulo: 'Notion'
                            descricao: 'Notas e organização'
                            imagem: 'assets/icon/notion.png'
                            simbolo: 'notebook-outline'
                            key: 'show_notion'
                            active: app.settings.show_notion
                        ServicoOpcao:
                            titulo: 'Trello'
                            descricao: 'Quadros e tarefas'
                            imagem: 'assets/icon/trello.png'
                            simbolo: 'view-column-outline'
                            key: 'show_trello'
                            active: app.settings.show_trello
                        ServicoOpcao:
                            titulo: 'Classroom'
                            descricao: 'Sala de aula Google'
                            imagem: 'assets/icon/classroom.png'
                            simbolo: 'google-classroom'
                            key: 'show_classroom'
                            active: app.settings.show_classroom
                        ServicoOpcao:
                            titulo: 'Discord web'
                            descricao: 'Comunicação online'
                            imagem: 'assets/icon/discord.png'
                            simbolo: 'message-text-outline'
                            key: 'show_discord'
                            active: app.settings.show_discord
                        ServicoOpcao:
                            titulo: 'GitHub'
                            descricao: 'Projetos e repositórios'
                            imagem: 'assets/icon/github.png'
                            simbolo: 'github'
                            key: 'show_github'
                            active: app.settings.show_github
                        ServicoOpcao:
                            titulo: 'Git Bash'
                            descricao: 'Terminal isolado'
                            imagem: 'assets/icon/git.png'
                            simbolo: 'console-line'
                            key: 'show_git'
                            active: app.settings.show_git
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(8)
                    Label:
                        text: 'Configurações do computador'
                        color: .05, .20, .48, 1
                        bold: True
                        font_size: '20sp'
                        size_hint_y: None
                        height: dp(28)
                        halign: 'left'
                        text_size: self.width, None
                    ConfiguracaoOpcao:
                        titulo: 'Tela cheia'
                        descricao: 'Aplicada imediatamente à janela do PM-Painel.'
                        key: 'fullscreen'
                        active: app.settings.fullscreen
                    ConfiguracaoOpcao:
                        titulo: 'Iniciar em modo laboratório'
                        descricao: 'Ativa automaticamente as regras de laboratório ao abrir o painel.'
                        admin_only: True
                        key: 'start_in_lab_mode'
                        active: app.settings.start_in_lab_mode
                    ConfiguracaoOpcao:
                        titulo: 'Bloquear fechamento do aplicativo'
                        descricao: 'Impede que alunos fechem o painel quando o modo laboratório estiver ativo; moderadores podem sair.'
                        admin_only: True
                        key: 'block_app_close'
                        active: app.settings.block_app_close
                    ConfiguracaoOpcao:
                        titulo: 'Bloquear acesso a determinadas funções'
                        descricao: 'No modo laboratório, bloqueia o catálogo de extensões e o Git Bash para alunos.'
                        admin_only: True
                        key: 'block_restricted_features'
                        active: app.settings.block_restricted_features
                    ConfiguracaoOpcao:
                        titulo: 'Mostrar informações do computador'
                        descricao: 'Exibe nome do dispositivo, sistema e memória neste painel.'
                        key: 'show_computer_info'
                        active: app.settings.show_computer_info
                    Label:
                        text: root.computer_info
                        color: app.theme_muted
                        font_size: '12sp'
                        size_hint_y: None
                        height: dp(24) if app.settings.show_computer_info else 0
                        opacity: 1 if app.settings.show_computer_info else 0
                        halign: 'left'
                        text_size: self.width, None
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(8)
                    Label:
                        text: 'Atualizações'
                        color: .05, .20, .48, 1
                        bold: True
                        font_size: '20sp'
                        size_hint_y: None
                        height: dp(28)
                        halign: 'left'
                        text_size: self.width, None
                    ConfiguracaoOpcao:
                        titulo: 'Verificar atualizações automaticamente'
                        descricao: 'Consulta as versões publicadas no GitHub quando o painel é aberto.'
                        key: 'auto_check_updates'
                        active: app.settings.auto_check_updates
                    ConfiguracaoOpcao:
                        titulo: 'Baixar atualizações automaticamente'
                        descricao: 'Baixa instaladores publicados com SHA-256 para a próxima inicialização.'
                        key: 'auto_download_updates'
                        active: app.settings.auto_download_updates
                    ConfiguracaoOpcao:
                        titulo: 'Instalar ao reiniciar'
                        descricao: 'Abre o instalador verificado quando o PM-Painel for iniciado novamente.'
                        key: 'install_updates_on_restart'
                        active: app.settings.install_updates_on_restart
                    BoxLayout:
                        size_hint_y: None
                        height: dp(64)
                        padding: dp(16), dp(10)
                        spacing: dp(10)
                        canvas.before:
                            Color:
                                rgba: app.theme_surface
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(14)]
                        IconeUI:
                            nome: 'source-branch'
                            size_hint: None, None
                            size: dp(22), dp(22)
                            font_size: '21sp'
                            color: app.theme_muted
                        Label:
                            text: 'Canal de atualização'
                            color: app.theme_text
                            bold: True
                            font_size: '15sp'
                            halign: 'left'
                            text_size: self.width, None
                        SeletorConfiguracao:
                            text: app.settings.update_channel
                            values: ('Stable', 'Beta', 'Development') if app.settings.language.startswith('English') else ('Estável', 'Beta', 'Desenvolvimento')
                            size_hint_x: None
                            width: dp(160)
                            on_text: root.set_choice('update_channel', self.text)
                    BotaoAcao:
                        variant: 'primary'
                        text: 'Verificar atualizações agora'
                        icone: 'refresh'
                        size_hint_y: None
                        height: dp(50)
                        on_release: root.verificar_atualizacoes()
                    BotaoAcao:
                        variant: 'secondary'
                        text: 'Abrir página de lançamentos'
                        icone: 'open-in-new'
                        size_hint_y: None
                        height: dp(46) if root.latest_update_url else 0
                        opacity: 1 if root.latest_update_url else 0
                        disabled: not root.latest_update_url
                        on_release: root.abrir_pagina_atualizacoes()
                    Label:
                        text: root.update_status
                        color: app.theme_text
                        font_size: '12sp'
                        size_hint_y: None
                        height: self.texture_size[1] if self.text else 0
                        halign: 'center'
                        text_size: self.width, None
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(8)
                    padding: dp(14)
                    canvas.before:
                        Color:
                            rgba: .06, .21, .48, .98
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(20)]
                    Label:
                        text: 'Modo laboratório'
                        color: 1, 1, 1, 1
                        bold: True
                        font_size: '20sp'
                        size_hint_y: None
                        height: dp(28)
                        halign: 'left'
                        text_size: self.width, None
                    Label:
                        text: 'Configure o comportamento do PM-Painel para computadores compartilhados em laboratórios.'
                        color: .86, .92, 1, 1
                        font_size: '13sp'
                        size_hint_y: None
                        height: self.texture_size[1]
                        halign: 'left'
                        text_size: self.width, None
                    ConfiguracaoOpcao:
                        titulo: 'Modo laboratório'
                        descricao: 'Ativa as preferências desta seção.'
                        admin_only: True
                        key: 'laboratory_mode'
                        active: app.settings.laboratory_mode
                    ConfiguracaoOpcao:
                        titulo: 'Limpar sessões ao sair'
                        descricao: 'Apaga a sessão local e o passe de acesso offline ao encerrar.'
                        admin_only: True
                        key: 'clear_sessions_on_exit'
                        active: app.settings.clear_sessions_on_exit
                    ConfiguracaoOpcao:
                        titulo: 'Limpar navegador temporário'
                        descricao: 'Remove os cookies e dados do navegador temporário ao encerrar.'
                        admin_only: True
                        key: 'clear_temporary_browser'
                        active: app.settings.clear_temporary_browser
                    ConfiguracaoOpcao:
                        titulo: 'Limpar sessões abandonadas ao iniciar'
                        descricao: 'Remove perfis temporários deixados por falha ou desligamento inesperado.'
                        admin_only: True
                        key: 'clear_abandoned_sessions'
                        active: app.settings.clear_abandoned_sessions
                    ConfiguracaoOpcao:
                        titulo: 'Bloquear persistência de login'
                        descricao: 'Abre os atalhos do navegador em modo privado e remove os dados ao sair.'
                        admin_only: True
                        key: 'prevent_login_persistence'
                        active: app.settings.prevent_login_persistence
                    BoxLayout:
                        size_hint_y: None
                        height: dp(64)
                        disabled: not app.is_moderator
                        padding: dp(16), dp(10)
                        spacing: dp(10)
                        canvas.before:
                            Color:
                                rgba: app.theme_surface
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(14)]
                        IconeUI:
                            nome: 'timer-outline'
                            size_hint: None, None
                            size: dp(22), dp(22)
                            font_size: '21sp'
                            color: app.theme_muted
                        Label:
                            text: 'Tempo máximo de sessão'
                            color: app.theme_text
                            bold: True
                            font_size: '15sp'
                            halign: 'left'
                            text_size: self.width, None
                        SeletorConfiguracao:
                            text: root.session_time_label(app.settings.maximum_session_time, app.settings.language)
                            values: ('30 minutes', '1 hour', '2 hours', '4 hours', '8 hours', 'Unlimited') if app.settings.language.startswith('English') else ('30 minutos', '1 hora', '2 horas', '4 horas', '8 horas', 'Ilimitado')
                            size_hint_x: None
                            width: dp(160)
                            on_text: root.set_choice('maximum_session_time', self.text)
