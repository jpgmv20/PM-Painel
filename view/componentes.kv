# view/componentes.kv

<MenuPerfil>:
    auto_width: False
    width: dp(150)

    BotaoFlutuante:
        text: "Perfil"
        on_release: root.select('perfil')
    
    BotaoFlutuante:
        text: 'Logout'
        color: 1, 0.3, 0.3, 1
        on_release: root.select('logout')

    BotaoFlutuante:
        text: 'Sair'
        color: 1, 0.3, 0.3, 1
        on_release: app.stop()



<FotoPerfil>:
    size_hint: None, None
    size: 40, 40
    background_color: 0, 0, 0, 0
    background_normal: ''
    
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Ellipse:
            pos: self.pos
            size: self.size
            source: root.source
    


<Cabecalho>:
    orientation: 'horizontal'
    size_hint_y: None
    height: 60
    padding: [30, 0, 30, 0]
    spacing: 15

    canvas.before:
        # 1. Fundo Gradiente Azul
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size
            texture: root.gradiente_textura

        # 2. Linhas Geométricas Decorativas no Canto Esquerdo
        Color:
            rgba: 1, 1, 1, 0.12  # Linhas semi-transparentes suaves
        Line:
            points: [self.x, self.y + 10, self.x + 80, self.top]
            width: 1.2
        Line:
            points: [self.x + 20, self.y, self.x + 120, self.top]
            width: 1.2
        Line:
            points: [self.x + 50, self.y, self.x + 160, self.top]
            width: 1.2

        # 3. Padrão de Pontos sutis no Canto Direito
        Color:
            rgba: 1, 1, 1, 0.25
        Ellipse:
            pos: self.right - 60, self.top - 20
            size: 4, 4
        Ellipse:
            pos: self.right - 45, self.top - 20
            size: 4, 4
        Ellipse:
            pos: self.right - 30, self.top - 20
            size: 4, 4
        Ellipse:
            pos: self.right - 60, self.top - 35
            size: 4, 4
        Ellipse:
            pos: self.right - 45, self.top - 35
            size: 4, 4
        Ellipse:
            pos: self.right - 30, self.top - 35
            size: 4, 4

        # 4. Linha de Destaque Borda Inferior (Cian/Azul Claro)
        Color:
            rgba: 0.3, 0.75, 1, 0.9
        Line:
            points: [self.x, self.y, self.right, self.y]
            width: 2

    # Título do Cabeçalho
    Label:
        text: root.titulo
        font_size: '22sp'
        bold: True
        color: 1, 1, 1, 1
        halign: 'left'
        text_size: self.size
        valign: 'middle'

    FotoPerfil:
        id: btn_perfil
        
        # APONTE O CAMINHO AQUI:
        source: ''
        
        pos_hint: {'center_y': 0.5}
        on_release: root.abrir_menu(self)

<Rodape>:
    orientation: 'horizontal'
    size_hint_y: None
    height: 45
    padding: [30, 0, 30, 0]

    canvas.before:
        # Borda superior
        Color:
            rgba: 0.1, 0.4, 0.8, 1
        Line:
            points: [self.x, self.top, self.right, self.top]
            width: 1.2
        # Fundo do rodapé
        Color:
            rgba: 0.03, 0.20, 0.45, 1
        Rectangle:
            pos: self.pos
            size: self.size

    # Texto Esquerda
    Label:
        text: "© 2026 Pedro Miguel - Todos os direitos reservados"
        font_size: '12sp'
        color: 0.8, 0.9, 1, 0.8
        halign: 'left'
        text_size: self.size
        valign: 'middle'

    # Texto Direita (Status de Conexão)
    Label:
        id: status_label
        text: root.status_texto
        font_size: '12sp'
        bold: True
        color: root.status_cor
        halign: 'right'
        text_size: self.size
        valign: 'middle'


<CardMenu>:
    orientation: 'vertical'
    padding: dp(16)
    spacing: dp(12)
    size_hint: 1, 1

    canvas.before:
        PushMatrix
        Translate:
            y: root.elevacao
        Color:
            rgba: 0, 0, 0, root.opacidade_sombra
        RoundedRectangle:
            pos: self.x + root.deslocamento_sombra[0], self.y + root.deslocamento_sombra[1]
            size: self.size
            radius: [dp(22)]
        Color:
            rgba: root.cor_fundo
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(22)]

    canvas.after:
        PopMatrix

    BoxLayout:
        size_hint_y: 0.80
        canvas.before:
            StencilPush
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(14)]
            StencilUse
        canvas.after:
            StencilUnUse
            StencilPop

        Image:
            source: root.imagem_source
            fit_mode: 'fill'
            size_hint: 1, 1

    BoxLayout:
        orientation: 'vertical'
        spacing: dp(20)
        size_hint_y: 0.20

        Label:
            text: root.titulo
            font_size: '40sp'
            bold: True
            color: 1, 1, 1, 1
            halign: 'left'
            valign: 'middle'
            text_size: self.width, None
            size_hint_y: None
            height: self.texture_size[1]

        Label:
            text: root.descricao
            font_size: '20sp'
            color: 0.9, 0.94, 1, 1
            halign: 'left'
            valign: 'top'
            text_size: self.size
            size_hint_y: 1


<LayoutFundo>:
    # Todo conteúdo que for jogado dentro desse layout será desenhado POR CIMA desse fundo
    canvas.before:
        # --- A) FUNDO GRADIENTE ---
        Color:
            rgba: 1, 1, 1, 1  
        Rectangle:
            pos: self.pos
            size: self.size
            texture: root.fundo_textura  

        # --- B) LINHAS GEOMÉTRICAS ---
        Color:
            rgba: 1, 1, 1, 0.15  
        Line:
            points: [self.x, self.top - 40, self.x + 60, self.top - 40, self.x + 100, self.top - 80, self.x + 100, self.top - 160]
            width: 1.2
        Line:
            points: [self.x, self.top - 70, self.x + 40, self.top - 70, self.x + 70, self.top - 100, self.x + 70, self.top - 130]
            width: 1.2
        Line:
            points: [self.x + 130, self.top, self.x + 130, self.top - 50, self.x + 80, self.top - 100]
            width: 1.2

        # --- C) MALHA DE PONTOS ---
        Color:
            rgba: 1, 1, 1, 0.2  
        Point:
            pointsize: 2
            points: [self.right - 40, self.top - 30, self.right - 60, self.top - 30, self.right - 80, self.top - 30, self.right - 100, self.top - 30, self.right - 40, self.top - 50, self.right - 60, self.top - 50, self.right - 80, self.top - 50, self.right - 100, self.top - 50, self.right - 40, self.top - 70, self.right - 60, self.top - 70, self.right - 80, self.top - 70, self.right - 100, self.top - 70, self.right - 40, self.top - 90, self.right - 60, self.top - 90, self.right - 80, self.top - 90, self.right - 100, self.top - 90]



# ==========================================
# 1. BOTÃO PRINCIPAL (Azul - Ação Destaque)
# ==========================================
<BotaoPrincipal@BotaoHover>:
    font_size: '16sp'
    bold: True
    color: 1, 1, 1, 1
    size_hint: None, None
    size: 220, 50
    pos_hint: {'center_x': 0.5}

    background_color: 0, 0, 0, 0
    background_normal: ''

    canvas.before:
        Color:
            rgba: 
                (0.05, 0.35, 0.7, 1) if self.state == 'down' \
                else ((0.2, 0.6, 1, 1) if self.hovering else (0.1, 0.5, 0.9, 1))
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [12]


# ==========================================
# 2. BOTÃO SECUNDÁRIO (Transparente com Borda)
# ==========================================
<BotaoSecundario@BotaoHover>:
    font_size: '14sp'
    bold: True
    color: 1, 1, 1, 0.9
    size_hint: None, None
    size: 180, 45
    pos_hint: {'center_x': 0.5}

    background_color: 0, 0, 0, 0
    background_normal: ''

    canvas.before:
        # Fundo semi-transparente que acende no Hover
        Color:
            rgba: (1, 1, 1, 0.25) if self.hovering else (1, 1, 1, 0.08)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [10]
            
        # Borda fina branca
        Color:
            rgba: 1, 1, 1, 0.5
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, 10)
            width: 1.1


# ==========================================
# 3. BOTÃO PERIGO / VOLTAR (Vermelho)
# ==========================================
<BotaoPerigo@BotaoHover>:
    font_size: '14sp'
    bold: True
    color: 1, 1, 1, 1
    size_hint: None, None
    size: 160, 40

    background_color: 0, 0, 0, 0
    background_normal: ''

    canvas.before:
        Color:
            rgba: 
                (0.6, 0.1, 0.1, 1) if self.state == 'down' \
                else ((0.9, 0.3, 0.3, 1) if self.hovering else (0.8, 0.2, 0.2, 1))
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [8]



<BotaoFlutuante@BotaoHover>:
    background_color: 0, 0, 0, 0
    background_normal: ''
    color: 1, 1, 1, 1  

    size_hint_y: None
    height: dp(40)

    
    canvas.before:
        Color:
            # Tudo na mesma linha para evitar erro de indentação no Kivy
            rgba: 
                (0.05, 0.35, 0.7, 1) if self.state == 'down' \
                else ((0.25, 0.25, 0.25, 1) if self.hovering else (0.15, 0.15, 0.15, 1))
        Rectangle:
            pos: self.pos
            size: self.size
