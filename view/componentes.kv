# view/componentes.kv

<Button>:
    font_name: app.font_family_medium

<CartaoMaterial>:
    style: 'elevated'
    radius: [dp(22), dp(22), dp(22), dp(22)]
    elevation: 2

<MenuPerfil>:
    auto_width: False
    width: dp(150)

    BotaoFlutuante:
        text: "Perfil"
        icone: 'account-circle-outline'
        on_release: root.select('perfil')
    
    BotaoFlutuante:
        id: logout_btn
        text: 'Logout'
        icone: 'logout-variant'
        disabled: root.logout_bloqueado
        color: (0.75, 0.75, 0.75, 1) if root.logout_bloqueado else (1, 0.3, 0.3, 1)
        on_release: root.select('logout')

    BotaoFlutuante:
        text: 'Sair'
        icone: 'exit-to-app'
        color: 1, 0.3, 0.3, 1
        on_release: app.solicitar_saida()



<FotoPerfil>:
    size_hint: None, None
    size: 40, 40
    background_color: 0, 0, 0, 0
    background_normal: ''
    
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Ellipse:
            pos: self.pos
            size: self.size
            source: root.source
    


<Cabecalho>:
    orientation: 'horizontal'
    size_hint_y: None
    height: 60
    padding: [30, 0, 30, 0]
    spacing: 15

    canvas.before:
        # 1. Fundo Gradiente Azul
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size
            texture: root.gradiente_textura

        # 2. Linhas Geométricas Decorativas no Canto Esquerdo
        Color:
            rgba: 1, 1, 1, 0.12  # Linhas semi-transparentes suaves
        Line:
            points: [self.x, self.y + 10, self.x + 80, self.top]
            width: 1.2
        Line:
            points: [self.x + 20, self.y, self.x + 120, self.top]
            width: 1.2
        Line:
            points: [self.x + 50, self.y, self.x + 160, self.top]
            width: 1.2

        # 3. Padrão de Pontos sutis no Canto Direito
        Color:
            rgba: 1, 1, 1, 0.25
        Ellipse:
            pos: self.right - 60, self.top - 20
            size: 4, 4
        Ellipse:
            pos: self.right - 45, self.top - 20
            size: 4, 4
        Ellipse:
            pos: self.right - 30, self.top - 20
            size: 4, 4
        Ellipse:
            pos: self.right - 60, self.top - 35
            size: 4, 4
        Ellipse:
            pos: self.right - 45, self.top - 35
            size: 4, 4
        Ellipse:
            pos: self.right - 30, self.top - 35
            size: 4, 4

        # 4. Linha de Destaque Borda Inferior (Cian/Azul Claro)
        Color:
            rgba: 0.3, 0.75, 1, 0.9
        Line:
            points: [self.x, self.y, self.right, self.y]
            width: 2

    # Título do Cabeçalho
    Label:
        text: root.titulo
        font_size: '22sp'
        bold: True
        color: 1, 1, 1, 1
        halign: 'left'
        text_size: self.size
        valign: 'middle'

    FotoPerfil:
        id: btn_perfil
        source: app.profile_photo
        
        pos_hint: {'center_y': 0.5}
        on_release: root.abrir_menu(self)

<Rodape>:
    orientation: 'horizontal'
    size_hint_y: None
    height: 45
    padding: [30, 0, 30, 0]

    canvas.before:
        # Borda superior
        Color:
            rgba: 0.1, 0.4, 0.8, 1
        Line:
            points: [self.x, self.top, self.right, self.top]
            width: 1.2
        # Fundo do rodapé
        Color:
            rgba: 0.03, 0.20, 0.45, 1
        Rectangle:
            pos: self.pos
            size: self.size

    # Texto Esquerda
    Label:
        text: "© 2026 Pedro Miguel - Todos os direitos reservados"
        font_size: '12sp'
        color: 0.8, 0.9, 1, 0.8
        halign: 'left'
        text_size: self.size
        valign: 'middle'

    # Texto Direita (Status de Conexão)
    Label:
        id: status_label
        text: root.status_texto
        font_size: '12sp'
        bold: True
        color: root.status_cor
        halign: 'right'
        text_size: self.size
        valign: 'middle'


<CardMenu>:
    orientation: 'horizontal'
    padding: dp(16)
    spacing: dp(12)
    size_hint: 1, 1
    md_bg_color: app.theme_surface
    elevation: 2
    radius: [dp(18), dp(18), dp(18), dp(18)]
    ripple_behavior: True

    AnchorLayout:
        size_hint_x: None
        width: dp(58)
        canvas.before:
            Color:
                rgba: (.13, .23, .37, 1) if app.settings.theme == 'Escuro' else (.90, .94, .99, 1)
            RoundedRectangle:
                pos: self.center_x - dp(26), self.center_y - dp(26)
                size: dp(52), dp(52)
                radius: [dp(16)]

        IconeUI:
            nome: root.icone
            size_hint: None, None
            size: dp(40), dp(40)
            font_size: '34sp'
            color: (.48, .72, 1, 1) if app.settings.theme == 'Escuro' else (0, .275, .588, 1)

    AnchorLayout:
        anchor_x: 'left'
        anchor_y: 'center'

        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height
            spacing: dp(5)

            Label:
                text: root.titulo
                font_size: '18sp'
                bold: True
                color: app.theme_text
                halign: 'left'
                valign: 'middle'
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1]

            Label:
                text: root.descricao
                font_size: '13sp'
                color: app.theme_muted
                halign: 'left'
                valign: 'middle'
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1]

    IconeUI:
        nome: 'chevron-right'
        size_hint: None, None
        size: dp(22), dp(22)
        font_size: '20sp'
        color: app.theme_muted


<LayoutFundo>:
    # Todo conteúdo que for jogado dentro desse layout será desenhado POR CIMA desse fundo
    canvas.before:
        # --- A) FUNDO GRADIENTE ---
        Color:
            rgba: 1, 1, 1, 1  
        Rectangle:
            pos: self.pos
            size: self.size
            texture: root.fundo_textura  

        # --- B) LINHAS GEOMÉTRICAS DECORATIVAS (Inferior / Lateral) ---
        Color:
            rgba: 1, 1, 1, 0.08  
        Line:
            points: [self.x, self.y + 130, self.x + 50, self.y + 130, self.x + 90, self.y + 90, self.x + 90, self.y + 30]
            width: 1.1
        Line:
            points: [self.x, self.y + 90, self.x + 35, self.y + 90, self.x + 65, self.y + 60, self.x + 65, self.y + 25]
            width: 1.1
        Line:
            points: [self.x + 120, self.y + 25, self.x + 120, self.y + 65, self.x + 75, self.y + 105]
            width: 1.1

        # --- C) MALHA DE PONTOS SUTIS ---
        Color:
            rgba: 1, 1, 1, 0.12  
        Point:
            pointsize: 2
            points: [self.right - 40, self.y + 40, self.right - 60, self.y + 40, self.right - 80, self.y + 40, self.right - 100, self.y + 40, self.right - 40, self.y + 60, self.right - 60, self.y + 60, self.right - 80, self.y + 60, self.right - 100, self.y + 60, self.right - 40, self.y + 80, self.right - 60, self.y + 80, self.right - 80, self.y + 80, self.right - 100, self.y + 80, self.right - 40, self.y + 100, self.right - 60, self.y + 100, self.right - 80, self.y + 100, self.right - 100, self.y + 100]



# ==========================================
# Ações do PM-Painel: cápsulas e contornos
# ==========================================
<BotaoAcao>:
    background_color: 0, 0, 0, 0
    background_normal: ''
    background_down: ''
    font_size: '14sp'
    font_name: app.font_family_medium
    bold: True
    halign: 'left' if root.icone else 'center'
    padding: (dp(42), dp(8)) if root.icone and root.icon_position == 'left' else (dp(18), dp(8)) if root.icone else (dp(16), dp(8))
    color: (0.08, 0.20, 0.39, 1) if root.variant == 'light' else (1, 1, 1, 1)

    canvas.before:
        Color:
            rgba: (0.02, 0.08, 0.18, 0.25) if not self.disabled else (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.x + dp(2), self.y - dp(3)
            size: self.size
            radius: [min(dp(28), self.height / 2)]
        Color:
            rgba: (0.02, 0.20, 0.43, 1) if root.variant == 'primary' and self.state == 'down' else (0.04, 0.34, 0.70, 1) if root.variant == 'primary' and self.hovering else (0, 0.275, 0.588, 1) if root.variant == 'primary' else (0.50, 0.13, 0.20, 1) if root.variant == 'danger' and self.state == 'down' else (0.76, 0.20, 0.27, 1) if root.variant == 'danger' else (0.22, 0.38, 0.61, 0.82) if root.variant == 'secondary' and self.hovering else (0.10, 0.23, 0.43, 0.62) if root.variant == 'secondary' else (0.78, 0.87, 0.98, 1) if root.variant == 'light' and self.state == 'down' else (0.94, 0.97, 1, 1) if root.variant == 'light' and self.hovering else (0.86, 0.92, 0.99, 1) if root.variant == 'light' else (0.12, 0.30, 0.53, 0.92) if self.hovering else (0.06, 0.16, 0.32, 0.72)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [min(dp(28), self.height / 2)]
        Color:
            rgba: (0.48, 0.80, 1, 0.9) if root.variant == 'primary' else (0.42, 0.69, 0.98, 0.72) if root.variant == 'secondary' else (0.43, 0.62, 0.85, 0.9) if root.variant == 'light' else (0, 0, 0, 0)
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, min(dp(28), self.height / 2))
            width: dp(1.1)

    IconeUI:
        nome: root.icone
        opacity: 1 if root.icone else 0
        size_hint: None, None
        size: dp(20), dp(20)
        font_size: '20sp'
        color: root.color
        pos:
            (root.x + dp(14), root.center_y - self.height / 2) if root.icon_position == 'left' else (root.right - self.width - dp(14), root.center_y - self.height / 2)


<BotaoPrincipal@BotaoAcao>:
    variant: 'primary'
    font_size: '16sp'
    size_hint: None, None
    size: dp(220), dp(54)
    pos_hint: {'center_x': 0.5}

<BotaoSecundario@BotaoAcao>:
    variant: 'secondary'
    size_hint: None, None
    size: dp(180), dp(46)
    pos_hint: {'center_x': 0.5}

<BotaoPerigo@BotaoAcao>:
    variant: 'danger'
    size_hint: None, None
    size: dp(160), dp(42)

<BotaoFlutuante@BotaoAcao>:
    variant: 'quiet'
    halign: 'left'
    size_hint_y: None
    height: dp(42)
